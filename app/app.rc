#include <winres.h>

// 1 = app (first icon: Explorer shows it for WVC.exe), 2..4 = tray: on air / pause / stopped
1 ICON "wvc.ico"
2 ICON "tray_live.ico"
3 ICON "tray_pause.ico"
4 ICON "tray_stop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,13,0,0
 PRODUCTVERSION 0,13,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WVC - screen area virtual camera"
            VALUE "FileVersion", "0.13.0"
            VALUE "ProductName", "WVC"
            VALUE "ProductVersion", "0.13.0"
            VALUE "LegalCopyright", "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
