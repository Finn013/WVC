<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WVC Phone"
            android:textColor="#0054A0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="IP-адрес телефона:"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textColor="#000000"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ipMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#000000"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Что показывать:"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Задняя камера" />

        <Button
            android:id="@+id/btnFront"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Передняя камера" />

        <Button
            android:id="@+id/btnScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Экран" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Качество:"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/resGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/res720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="720p (быстрее)" />

            <RadioButton
                android:id="@+id/res1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p (чётче)" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/keepOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Не выключать экран, пока приложение открыто" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="На компьютере: WVC → вкладка «Источники» → «Телефон» → «Найти» (или введите IP выше). Телефон и компьютер должны быть в одной сети Wi-Fi. Можно свернуть приложение и выключить экран — трансляция продолжится."
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Остановить и выйти" />
    </LinearLayout>
</ScrollView>
